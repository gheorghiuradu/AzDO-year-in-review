{
    "manifestVersion": 1,
    "id": "year-in-review-dev",
    "version": "0.1.5",
    "name": "Year in Review-Dev",
    "description": "A Spotify Wrapped-style review of your team's year in Azure DevOps",
    "publisher": "RaduGheorghiu",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "icons": {
        "default": "images/icon.png"
    },
    "categories": [
        "Azure Repos",
        "Azure Boards",
        "Azure Pipelines"
    ],
    "scopes": [
        "vso.code",
        "vso.build",
        "vso.work",
        "vso.wiki"
    ],
    "contributions": [
        {
            "id": "year-in-review-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Year in Review",
                "uri": "dist/index.html",
                "icon": "asset://images/icon.png"
            }
        }
    ],
    "files": [
        {
            "path": "dist",
            "addressable": true
        },
        {
            "path": "images",
            "addressable": true
        }
    ]
}