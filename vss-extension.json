{
    "manifestVersion": 1,
    "id": "year-in-review",
    "version": "0.9.8",
    "name": "Year in Review",
    "description": "A Spotify Wrapped-style review of your team's year in Azure DevOps",
    "publisher": "RaduGheorghiu",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "icons": {
        "default": "images/icon.png"
    },
    "categories": [
        "Azure Repos",
        "Azure Boards",
        "Azure Pipelines"
    ],
    "scopes": [
        "vso.code",
        "vso.build",
        "vso.work",
        "vso.wiki"
    ],
    "contributions": [
        {
            "id": "year-in-review-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Year in Review",
                "uri": "dist/index.html",
                "icon": {
                    "light": "images/hub-icon-light.png",
                    "dark": "images/hub-icon-dark.png"
                }
            }
        }
    ],
    "content": {
        "details": {
            "path": "OVERVIEW.md"
        },
        "license": {
            "path": "LICENSE.txt"
        }
    },
    "links": {
        "support": {
            "uri": "https://github.com/gheorghiuradu/AzDO-year-in-review/issues"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gheorghiuradu/AzDO-year-in-review"
    },
    "files": [
        {
            "path": "dist",
            "addressable": true
        },
        {
            "path": "images",
            "addressable": true
        },
        {
            "path": "screenshots",
            "addressable": true
        }
    ]
}