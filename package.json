{
  "name": "azdo-year-in-review",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint .",
    "package:dev": "npm run build && npx tfx-cli extension create --overrides-file configs/dev.json --rev-version",
    "publish:dev": "npm run build && source .env && npx tfx-cli extension publish --overrides-file configs/dev.json --token $PAT",
    "package:release": "npm run build && npx tfx-cli extension create --overrides-file configs/release.json --rev-version",
    "publish:release": "npm run build && source .env && npx tfx-cli extension publish --overrides-file configs/release.json --token $PAT"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.80",
    "azure-devops-extension-api": "^4.265.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.23.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-plugin-amd": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.5",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
